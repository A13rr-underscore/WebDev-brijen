{
  "name": "pf",
  "version": "0.0.7",
  "description": "Agent- and human-friendly Git multitasking, powered by worktrees",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pullfrog/pf.git"
  },
  "homepage": "https://github.com/pullfrog/pf#readme",
  "bugs": {
    "url": "https://github.com/pullfrog/pf/issues"
  },
  "keywords": [
    "git",
    "worktree",
    "parallel",
    "development",
    "multitasking",
    "agent",
    "isolation"
  ],
  "bin": {
    "pf": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc && node build.ts",
    "postbuild": "ln -sf $(pwd)/dist/index.js /usr/local/bin/pf-dev",
    "dev": "node build.ts --watch",
    "prepare": "husky && node build.ts",
    "typecheck": "tsc",
    "test": "./test.sh"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "picocolors": "^1.0.0",
    "smol-toml": "^1.3.1",
    "table": "^6.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "husky": "^9.1.7",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=24"
  }
}
